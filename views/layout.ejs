<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Hussain Qazi</title>
  <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
  <link rel="stylesheet" href="/stylesheets/all.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <!-- This displays the shared header, using the course layout pattern. -->
  <%- include('partials/header') %>
  <main class="container py-3" id="main-content">
    <!-- This inserts the page selected by the route. -->
    <%- body %>
  </main>
  <!-- This displays the shared footer. -->
  <%- include('partials/footer') %>
  <!-- Bootstrap runs the mobile navigation menu. -->
  <script src="/javascripts/bootstrap.bundle.min.js"></script>
</body>
</html>

