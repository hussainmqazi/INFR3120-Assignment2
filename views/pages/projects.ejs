<section id="projects" class="portfolio-section">
  <% if (title == 'Home') { %>
    <h2 class="section-title">Projects</h2>
  <% } else { %>
    <h1>Projects</h1>
  <% } %>
  <!-- Simple Bootstrap columns; each full artwork keeps its natural proportions. -->
  <div class="row g-4">
    <article class="col-md-6 col-lg-4 gallery-project">
      <a class="gallery-image" href="/images/still-life.jpg"><img class="img-fluid" src="/images/still-life.jpg" alt="Watercolour still life painting of a pear and an apple"></a>
      <h3>Still Life Drawing</h3>
      <p class="small">This watercolour shows a pear and an apple resting on a surface. Light and dark shading give the fruit shape and separate it from the background.</p>
    </article>
    <article class="col-md-6 col-lg-4 gallery-project">
      <a class="gallery-image" href="/images/minar-pakistan.jpg"><img class="img-fluid portrait-art" src="/images/minar-pakistan.jpg" alt="Minar-e-Pakistan in watercolour and pen"></a>
      <h3>Minar-e-Pakistan</h3>
      <p class="small">This artwork shows the Minar-e-Pakistan monument against a warm-coloured sky. Pen lines define the monument's details, while watercolour adds colour to the background.</p>
    </article>
    <article class="col-md-6 col-lg-4 gallery-project">
      <a class="gallery-image" href="/images/sunset-painting.jpg"><img class="img-fluid" src="/images/sunset-painting.jpg" alt="Acrylic sunset painting with a reflection in water"></a>
      <h3>Sunset Reflection Painting</h3>
      <p class="small">This acrylic painting shows a sunset scene reflected in water. Warm yellows and oranges contrast with the dark silhouette and the reflections.</p>
    </article>
  </div>
  <div class="row g-4 align-items-center mt-2">
    <article class="col-md-6 col-lg-4 gallery-project">
      <a class="gallery-image" href="/images/birdsandmoon.jpg"><img class="img-fluid portrait-art" src="/images/birdsandmoon.jpg" alt="Pencil drawing of birds in front of the moon, with mountains and water"></a>
      <h3>Bird and Moon Pencil Drawing</h3>
      <p class="small">This pencil drawing shows birds in front of the moon, with mountains and water below. Pencil shading creates contrast between the dark birds, the pale moon, and the reflections.</p>
    </article>
  <section class="col-md-6 col-lg-8 content-creation">
    <h3>Content Creation</h3>
    <p>I create short-form Instagram content geared towards university students. It's another creative interest I enjoy alongside drawing and painting.</p>
    <p class="mt-3">Instagram: <a href="https://www.instagram.com/jus_tsain/">@jus_tsain</a></p>
  </section>
  </div>
</section>

