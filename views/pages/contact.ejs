<section>
  <h1>Contact Me</h1>


  <div class="row g-4 mt-1">
    <div class="col-md-7">
      <h2>Contact form</h2>
      <p id="form-note">This form is a demonstration. It does not send or save messages.</p>
      <% if (submitted) { %>
        <div class="alert alert-success" role="status">Thanks, <strong><%= name %></strong>! Your form was submitted successfully for this demonstration. No message was sent or stored.</div>
      <% } %>
      <% if (formError != '') { %>
        <div class="alert alert-danger" role="alert"><%= formError %></div>
      <% } %>
      <!-- Week2, pages 29-30: required fields and HTML5 email validation. -->
      <form action="/contact" method="post" class="row g-3" aria-describedby="form-note">
        <div class="col-md-6">
          <label class="form-label" for="contact-name">Name (required)</label>
          <input class="form-control" id="contact-name" name="name" type="text" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="contact-email">Email (required)</label>
          <input class="form-control" id="contact-email" name="email" type="email" required>
        </div>
        <div class="col-12">
          <label class="form-label" for="contact-message">Message (required)</label>
          <textarea class="form-control" id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <div class="col-12">
          <button class="btn btn-primary" type="submit"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Submit demo form</button>
        </div>
      </form>
    </div>
    <div class="col-md-5">
      <h2>Contact details</h2>
      <p><a href="https://www.instagram.com/jus_tsain/"><i class="fa-brands fa-instagram" aria-hidden="true"></i> @jus_tsain</a></p>
      <p>Email: <a href="mailto:hussainmqazi@gmail.com">hussainmqazi@gmail.com</a></p>
      <p>Ontario Tech University<br>Networking and IT Security student</p>
    </div>
  </div>
</section>

