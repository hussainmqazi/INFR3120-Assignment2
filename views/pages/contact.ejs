<section id="contact" class="portfolio-section contact-page">
  <% if (title == 'Home') { %>
    <h2 class="section-title">Contact Me</h2>
  <% } else { %>
    <h1>Contact Me</h1>
  <% } %>
  <div class="row g-4 mt-1">
    <div class="col-md-7">
      <h2>Contact form</h2>
      <p>This form is a demonstration. It does not send emails or save messages. To contact me, use my email or Instagram link.</p>
      <!-- This shows the confirmation after a successful form submission. -->
      <% if (submitted) { %>
        <div class="alert alert-success" role="status">Thanks, <strong><%= name %></strong>! Your demonstration form was submitted. No message was sent or saved.</div>
      <% } %>
      <!-- This shows an error if the server finds an empty field. -->
      <% if (formError != '') { %>
        <div class="alert alert-danger" role="alert"><%= formError %></div>
      <% } %>
      <!-- The browser checks required fields and email format, as in Week2. -->
      <form action="/contact" method="post" class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="contact-name">Name</label>
          <input class="form-control" id="contact-name" name="name" type="text" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="contact-email">Email</label>
          <input class="form-control" id="contact-email" name="email" type="email" required>
        </div>
        <div class="col-12">
          <label class="form-label" for="contact-message">Message</label>
          <textarea class="form-control" id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <div class="col-12">
          <button class="btn btn-primary" type="submit">Submit</button>
        </div>
      </form>
    </div>
    <div class="col-md-5">
      <h2>Contact details</h2>
      <p>Instagram: <a href="https://www.instagram.com/jus_tsain/">@jus_tsain</a></p>
      <p>Email: <a href="mailto:hussainmqazi@gmail.com">hussainmqazi@gmail.com</a></p>
      <p>Ontario Tech University<br>Networking and IT Security student</p>
    </div>
  </div>
</section>


