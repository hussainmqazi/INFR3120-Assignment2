#!/usr/bin/env node

// This loads the app and server packages.

var app = require('../app');
var debug = require('debug')('infr3120-assignment2:server');
var http = require('http');

// This uses the configured port, or port 3000 by default.

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

// This creates the server for the Express app.

var server = http.createServer(app);

// This starts the server and connects its error and startup handlers.

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// This checks the port value before the server uses it.

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // A non-number is treated as a named pipe.
    return val;
  }

  if (port >= 0) {
    // A non-negative number is used as the port.
    return port;
  }

  return false;
}

// This handles problems starting the server.

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // These messages explain permission problems or a port already in use.
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

// This writes the listening address to the debug log when enabled.

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
